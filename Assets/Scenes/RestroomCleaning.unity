  currentLevel:
    levelName: 1
    tasks:
    - taskText: Flush the toilet
      timeLimit: 15
      instructions:
      - Click the "Wear Gloves" button to put on gloves.
      - Click the flush handle to flush the toilet.
    - taskText: Clean the toilet
      timeLimit: 100
      instructions:
      - Click the "Apply Toilet Cleaner" button.
      - Drag the brush and scrub inside the bowl.
    - taskText: Clean the toilet seat
      timeLimit: 60
      instructions:
      - Click the "Get Towel" button to get a towel.
      - Drag the towel to the highlighted mess spots on the seat and lid.
    - taskText: Clean the floor
      timeLimit: 60
      instructions:
      - Drag each tissue paper and drop it into the trash bin.
    - taskText: Mop the floor
      timeLimit: 180
      instructions:
      - Drag the mop across all the highlighted floor areas.
